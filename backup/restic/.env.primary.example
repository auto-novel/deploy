# Copy to .env on the Primary host. Each deployment directory uses its own .env.

# ============================================================
# Primary identity
# ============================================================

# Stable hostname stored in restic snapshot metadata.
RESTIC_HOSTNAME=auto-novel-primary
RESTIC_TAG=auto-novel

# These paths are unconditionally mounted read-only by Compose.
# There is intentionally no variable that can switch them to read-write.
WENKU_PATH=/root/auto-novel/data/files-wenku
EXTRA_PATH=/root/auto-novel/data/files-extra

TZ=Asia/Shanghai

# ============================================================
# Target Replica
# ============================================================

# One env file represents one target repository. Use exactly one URL.
# For Tailscale, use rest:http://<backup-tailscale-ip>:8000/auto-novel/.
RESTIC_REPOSITORY=rest:https://backup.example.com/auto-novel/

# Must match RESTIC_REST_USERNAME / RESTIC_REST_PASSWORD in this Backup's env.
# Use /<username>/ as the repository URL path, without an extra subrepository.
RESTIC_REST_USERNAME=auto-novel
RESTIC_REST_PASSWORD='replace-with-a-long-random-rest-password'

# Repository encryption password; must match RESTIC_PASSWORD in Backup's env.
# For an existing repository, keep the original password.
RESTIC_PASSWORD='replace-with-a-long-random-repository-password'


# ============================================================
# Cache / resource limits
# ============================================================

# Prefer an SSD/system disk.
# For multiple targets, use a separate cache per target, e.g. ./data/cache/replica-02.
RESTIC_CACHE_PATH=./data/cache

# Conservative defaults for a low-performance backup setup.
RESTIC_READ_CONCURRENCY=4
NICE=10
IONICE_CLASS=2
IONICE_PRIORITY=7
