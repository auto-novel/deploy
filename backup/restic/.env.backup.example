# Copy to .env on the Backup host. Each deployment directory uses its own .env.

# ============================================================
# Replica identity
# ============================================================

REPLICA_NAME=auto-novel-backup
TZ=Asia/Shanghai


# ============================================================
# HTTP REST endpoint
# ============================================================

# Host bind address (not a URL, and without a port).
# 127.0.0.1: host-local proxy / cloudflared; 100.x.y.z: Tailscale only.
# 0.0.0.0: all host IPv4 interfaces, including public and Tailscale addresses.
REST_SERVER_LISTEN_ADDRESS=127.0.0.1
REST_SERVER_PORT=8000

# Single REST account; also names the private repository subdirectory.
# Credentials must match the corresponding Primary env. Authentication is generated on startup.
RESTIC_REST_USERNAME=auto-novel
RESTIC_REST_PASSWORD='replace-with-a-long-random-rest-password'

# Encryption password used by local initialization/mount/admin; must match Primary.
# For an existing repository, keep the original password.
RESTIC_PASSWORD='replace-with-a-long-random-repository-password'

# Repository packs live on the low-performance HDD.
# Actual repository: RESTIC_REPOSITORY_PATH/RESTIC_REST_USERNAME.
# Backup creates an absent repository automatically; existing repositories are reused.
RESTIC_REPOSITORY_PATH=/data/restic/data

# Restic index/cache data should not share the HDD with repository packs.
RESTIC_CACHE_PATH=./data/cache

# Optional FUSE root; only used after explicitly starting restic-mount.
# Current content appears below snapshots/latest/. Prepare a shared mount before use.
# A sibling of the repository root, not a directory inside it.
RESTIC_MOUNT_PATH=/data/restic/mount

# Must match the hostname and tag used by Primary.
RESTIC_PRIMARY_HOSTNAME=auto-novel-primary
RESTIC_TAG=auto-novel

# Optional repository quota in bytes. Zero disables the quota.
# Reaching the quota rejects uploads; it does not delete old snapshots.
REST_SERVER_MAX_SIZE=0


# ============================================================
# Local maintenance resource limits
# ============================================================

# Applied to local initialization and restic-admin, including just cleanup.
NICE=10
IONICE_CLASS=2
IONICE_PRIORITY=7

# Maximum data repacked per cleanup run. Repeat cleanup to reclaim more space.
RESTIC_PRUNE_MAX_REPACK_SIZE=1G
